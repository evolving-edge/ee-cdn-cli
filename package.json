{
  "name": "@evolving-edge/cdn-cli",
  "version": "0.1.0",
  "description": "Publish a static site to the Evolving Edge CDN \u2014 a CLI for any generator, plus an Astro integration.",
  "type": "module",
  "license": "MIT",
  "author": "Evolving Edge",
  "homepage": "https://github.com/evolving-edge/cdn-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evolving-edge/cdn-cli.git"
  },
  "bugs": {
    "url": "https://github.com/evolving-edge/cdn-cli/issues"
  },
  "keywords": [
    "cdn",
    "edge",
    "static-site",
    "deploy",
    "cli",
    "astro",
    "astro-integration",
    "hugo",
    "eleventy",
    "publii"
  ],
  "exports": {
    ".": {
      "default": "./src/deploy.js"
    },
    "./astro": {
      "types": "./astro.d.ts",
      "default": "./src/astro.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "astro.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "dependencies": {
    "rehype-parse": "^9.0.0",
    "rehype-stringify": "^10.0.0",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "scripts": {
    "test": "node --test"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ee-deploy": "./bin/ee-deploy.js"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  }
}
